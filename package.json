{
  "name": "hypatia-hoard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').readdirSync('.').filter(f=>f.startsWith('vite.config.ts.timestamp')).forEach(f=>require('fs').unlinkSync(f))\"",
    "predev": "npm run clean",
    "prebuild": "npm run clean",
    "dev": "vite",
    "build": "node tools/build-hoard.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "dexie": "^3.2.7",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "mammoth": "^1.11.0",
    "marked": "^17.0.3",
    "marked-katex-extension": "^5.1.7",
    "mespeak": "^2.0.2",
    "onnxruntime-web": "^1.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0"
  }
}
